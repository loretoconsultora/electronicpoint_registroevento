# Webhook que recibe cada inscripción: guarda la fila en Google Sheets y
# manda el email de notificación. Puede ser la URL de producción de un
# workflow de n8n, o el Web App URL de un Google Apps Script. Ver README.
REGISTRATION_WEBHOOK_URL=

# Inbound Webhook del Workflow de GoHighLevel que carga el lead en el CRM.
# Opcional: si falta, el registro sigue funcionando y solo se omite este envío.
GOHIGHLEVEL_WEBHOOK_URL=
